# App mobile (Expo) — valeurs publiques uniquement
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_API_BASE_URL=https://api.mecacheck.ai

# Backend (/server) — NE JAMAIS committer les vraies valeurs
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # secret, côté serveur uniquement
PORT=3000
RATE_LIMIT_MAX_REQUESTS_PER_MIN=20

# --- Fournisseur IA (couche d'abstraction, voir server/src/services/ai) ---
# Aucun fournisseur n'est actif par défaut. Choix explicite requis :
# AI_PROVIDER=anthropic | openai   (laisser vide = analyse IA désactivée)
AI_PROVIDER=

# Clés/modèles par fournisseur — ne renseigner QUE celle du fournisseur
# choisi, une fois la décision validée. Ne jamais committer de vraie clé.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
